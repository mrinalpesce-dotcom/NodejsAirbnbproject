<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>airbnb | Discover unique stays</title>
    <meta name="description" content="Book unique homes and stays around the world.">
    <link rel="stylesheet" href="/home.css">
</head>

<body>
    <header class="topbar">
        <nav class="nav container">
            <div class="brand" aria-label="Airbnb home">
                <span class="brand-icon">air</span>
                <span class="brand-text">bnb</span>
            </div>

            <div class="nav-links">
                <a href="#">Stays</a>
                <a href="#">Experiences</a>
                <a href="#">Online Experiences</a>
            </div>

            <div class="nav-actions">
                <a href="#">Become a host</a>
                <button class="nav-button">Sign in</button>
            </div>
        </nav>
    </header>

    <main>
        <section class="hero container">
            <div class="hero-copy">
                <p class="eyebrow">Stay somewhere unforgettable</p>

                <h1>Find the perfect getaway for your next adventure.</h1>

                <p class="hero-text">
                    Discover hand-picked homes, cozy cabins, beach villas, and stylish city escapes designed for memorable stays.
                </p>

                <div class="cta-row">
                    <a href="/add-home" class="primary-btn">Add your home</a>
                    <a href="#featured" class="secondary-btn">Explore stays</a>
                </div>

                <div class="stats" aria-label="Airbnb statistics">
                    <div>
                        <strong>200K+</strong>
                        <span>Happy guests</span>
                    </div>

                    <div>
                        <strong>4.8/5</strong>
                        <span>Average rating</span>
                    </div>

                    <div>
                        <strong>120+</strong>
                        <span>Destinations</span>
                    </div>
                </div>
            </div>

            <div class="hero-visual" aria-label="Featured property preview">
                <div class="image-card">
                    <img src="https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=900&q=80" alt="Modern mountain home with glass walls">

                    <div class="image-badge">
                        <span class="badge-title">Featured stay</span>
                        <strong>Glass House, Banff</strong>
                        <span>From $220/night</span>
                    </div>
                </div>
            </div>
        </section>

        <section id="featured" class="featured container">
            <div class="section-header">
                <div>
                    <p class="eyebrow">Popular experiences</p>
                    <h2>Recommended for you</h2>
                </div>

                <a href="#">View all</a>
            </div>

            <div class="card-grid">
                <article class="stay-card">
                    <img src="https://images.unsplash.com/photo-1494526585095-c41746248156?auto=format&fit=crop&w=800&q=80" alt="Beach villa exterior">

                    <div class="card-body">
                        <div class="card-meta">
                            <span>Entire villa</span>
                            <span>⭐ 4.9</span>
                        </div>

                        <h3>Coastal Haven</h3>
                        <p>Sunset views, private pool, and direct beach access.</p>
                        <strong>$310/night</strong>
                    </div>
                </article>

                <article class="stay-card">
                    <img src="https://images.unsplash.com/photo-1484154218962-a197022b5858?auto=format&fit=crop&w=800&q=80" alt="Modern apartment interior">

                    <div class="card-body">
                        <div class="card-meta">
                            <span>City apartment</span>
                            <span>⭐ 4.8</span>
                        </div>

                        <h3>Urban Nest</h3>
                        <p>Contemporary design with rooftop terrace and skyline views.</p>
                        <strong>$185/night</strong>
                    </div>
                </article>

                <article class="stay-card">
                    <img src="https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?auto=format&fit=crop&w=800&q=80" alt="Forest cabin">

                    <div class="card-body">
                        <div class="card-meta">
                            <span>Cabin retreat</span>
                            <span>⭐ 5.0</span>
                        </div>

                        <h3>Forest Whisper</h3>
                        <p>Quiet woodland escape with fireplace and hot tub.</p>
                        <strong>$240/night</strong>
                    </div>
                </article>
            </div>
        </section>

        <!-- Registered homes section -->
        <section class="featured container">
            <div class="section-header">
                <div>
                    <p class="eyebrow">Become a host</p>
                    <h2>Here are our registered homes</h2>
                </div>
            </div>

            <ul>
                <% if (registerhouse && registerhouse.length > 0) { %>

                    <% registerhouse.forEach(home => { %>
                        <li>
                            <%= home.houseName %>
                        </li>
                        <% }) %>

                            <% } else { %>

                                <li>No homes registered yet.</li>

                                <% } %>
            </ul>
        </section>
    </main>
</body>

</html>